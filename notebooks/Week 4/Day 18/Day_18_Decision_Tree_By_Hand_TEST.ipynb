    "def my_tree(income, defaulted):\n",
    "    if income <= 100:\n",
    "        return 0                 # not approved\n",
    "    if defaulted == 1:\n",
    "        return 0                 # not approved\n",
    "    return 1                     # approved\n",
    "\n",
    "print(\"income 130, never defaulted:\", my_tree(130, 0), \"(1 = approved)\")"
   ]
